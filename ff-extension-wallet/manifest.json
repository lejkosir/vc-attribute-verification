{
  "manifest_version": 2,
  "name": "VC Wallet",
  "version": "2.0",
  "description": "ZK age verification wallet",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "http://localhost/*"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src blob:;",
  "background": {
    "scripts": ["libs/snarkjs.min.js", "background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "VC Wallet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
